# Required OpenAI-compatible LLM configuration.
# Copy this file to backend/.env for both local and Docker Compose deployment.
OPENAI_API_KEY=your_api_key_here
OPENAI_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
MODEL_NAME=qwen-plus
OPENAI_TIMEOUT_SECONDS=30
OPENAI_MAX_RETRIES=0
SESSION_TTL_HOURS=24
CORS_ALLOWED_ORIGINS=http://localhost:8080,http://127.0.0.1:8080
# Used by scripts/start-local.ps1 when supplied as a PowerShell environment variable.
MEMORY_AGENT_API_BASE=http://127.0.0.1:8001
