# DashScope OpenAI-compatible API configuration
OPENAI_API_KEY=your_api_key_here
OPENAI_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
MODEL_NAME=qwen-plus
OPENAI_TIMEOUT_SECONDS=30
OPENAI_MAX_RETRIES=0
SESSION_TTL_HOURS=24
APP_TIMEZONE=Asia/Shanghai
CORS_ALLOWED_ORIGINS=http://localhost:8080,http://127.0.0.1:8080
# Optional inspiration rendering. Never expose this key to the frontend.
INSPIRATION_RENDERING_PROVIDER=tavily
INSPIRATION_SEARCH_API_KEY=your_search_api_key_here
INSPIRATION_SEARCH_BASE_URL=https://api.tavily.com/search
INSPIRATION_SEARCH_TIMEOUT_SECONDS=8
INSPIRATION_SEARCH_MAX_RETRIES=1
INSPIRATION_SEARCH_REQUEST_LIMIT=10
INSPIRATION_RENDERING_RESULT_LIMIT=5
INSPIRATION_SUMMARY_MODEL=qwen-plus
INSPIRATION_SUMMARY_TIMEOUT_SECONDS=15
